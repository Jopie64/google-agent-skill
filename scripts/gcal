#!/usr/bin/env python3
"""gcal — minimal Google Calendar CLI for Termux (Gids).

Commands:
  auth                          One-time OAuth flow (opens URL / local redirect on this device)
  list                          List calendars
  today [calendar]              Events today (all calendars if no name given)
  week [N] [calendar]           Events in next N days (default 7)
  add "Title" YYYY-MM-DD HH:MM [duration_min] [calendar]

Calendar is matched case-insensitively on summary or id (substring).
"""
import sys, os, json
from pathlib import Path

CFG = Path.home() / ".config" / "gcal"
SECRET = CFG / "client_secret.json"
TOKEN = CFG / "token.json"
SCOPES = ["https://www.googleapis.com/auth/calendar"]

def get_verifier():
    """PKCE verifier: random per installation, persisted across processes
    (auth URL and code exchange are separate invocations). Never commit it."""
    import secrets as _secrets
    f = CFG / "verifier"
    if f.exists():
        return f.read_text().strip()
    v = "".join(_secrets.choice("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789") for _ in range(64))
    CFG.mkdir(parents=True, exist_ok=True)
    f.write_text(v)
    f.chmod(0o600)
    return v

def client():
    from google.oauth2.credentials import Credentials
    from google.auth.transport.requests import Request
    if not TOKEN.exists():
        sys.exit("Run 'gcal auth' first.")
    creds = Credentials.from_authorized_user_file(str(TOKEN), SCOPES)
    if creds.expired and creds.refresh_token:
        creds.refresh(Request())
        TOKEN.write_text(creds.to_json())
    from googleapiclient.discovery import build
    return build("calendar", "v3", credentials=creds)

def auth():
    CFG.mkdir(parents=True, exist_ok=True)
    if not SECRET.exists():
        sys.exit(f"Put your OAuth client secret at {SECRET} first.")
    from google_auth_oauthlib.flow import Flow
    verifier = get_verifier()
    flow = Flow.from_client_secrets_file(str(SECRET), SCOPES,
                                         redirect_uri="http://localhost:8199",
                                         code_verifier=verifier,
                                         autogenerate_code_verifier=False)
    auth_url, _ = flow.authorization_url(access_type="offline", prompt="consent")
    print("Open this URL in your browser:\n\n" + auth_url +
          "\n\nThen paste the redirect URL you land on (starts with http://localhost:8199...):")
    code_url = input().strip()
    from urllib.parse import urlparse, parse_qs
    flow.fetch_token(code=parse_qs(urlparse(code_url).query)["code"][0])
    TOKEN.write_text(flow.credentials.to_json())
    print("Authorized. Token saved to", TOKEN)

def calendars(svc):
    return svc.calendarList().list().execute()["items"]

def resolve(svc, name):
    """Resolve a calendar name (substring, case-insensitive) to one calendar."""
    cals = calendars(svc)
    hits = [c for c in cals if name.lower() in c["summary"].lower() or name.lower() in c["id"].lower()]
    if not hits:
        sys.exit(f"Geen kalender gevonden voor '{name}'. Kies uit:\n" +
                 "\n".join(f"  {c['summary']}" for c in cals))
    if len(hits) > 1:
        sys.exit("Meerdere kalenders matchen '" + name + "':\n" +
                 "\n".join(f"  {c['summary']} — {c['id']}" for c in hits))
    return hits[0]

def show(svc, days, cal_name, cals):
    import datetime
    tmin = datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z")
    tmax = (datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(days=days)).isoformat().replace("+00:00", "Z")
    total = 0
    for c in cals:
        evs = svc.events().list(calendarId=c["id"], timeMin=tmin, timeMax=tmax,
                                singleEvents=True, orderBy="startTime").execute().get("items", [])
        for e in evs:
            s = e["start"].get("dateTime", e["start"].get("date", "?"))[:16].replace("T", " ")
            tag = c["summary"] if cal_name is None else ""
            print(f"{s}  [{tag}] {e.get('summary','(geen titel)')}" if tag else f"{s}  {e.get('summary','(geen titel)')}")
            total += 1
    print(f"({total} events in {len(cals)} kalender(s))", file=sys.stderr)

def add(svc, title, date, time, mins, cal_name):
    import datetime
    cid = cal_name["id"] if isinstance(cal_name, dict) else "primary"
    start = datetime.datetime.fromisoformat(f"{date}T{time}").isoformat()
    end = (datetime.datetime.fromisoformat(f"{date}T{time}") +
           datetime.timedelta(minutes=int(mins))).isoformat()
    svc.events().insert(calendarId=cid, body={
        "summary": title, "start": {"dateTime": start}, "end": {"dateTime": end}}).execute()
    print("Toegevoegd aan", cal_name.get("summary", "primary") if isinstance(cal_name, dict) else "primary",
          ":", title)

def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "today"
    args = sys.argv[2:]
    if cmd == "auth":
        auth()
    elif cmd == "list":
        for c in calendars(client()):
            print(c["summary"], "—", c["id"])
    elif cmd in ("today", "week"):
        svc = client()
        if cmd == "week" and args and args[0].isdigit():
            days = int(args.pop(0))
        else:
            days = 1 if cmd == "today" else 7
        cal_name = args.pop(0) if args else None
        if cal_name:
            show(svc, days, cal_name, [resolve(svc, cal_name)])
        else:
            show(svc, days, None, calendars(svc))
    elif cmd == "add":
        if len(args) < 3:
            print(__doc__); sys.exit(1)
        title, date, time = args[0], args[1], args[2]
        mins = args[3] if len(args) > 3 else 60
        cal_name = args[4] if len(args) > 4 else None
        svc = client()
        cal = resolve(svc, cal_name) if cal_name else {"id": "primary", "summary": "primary"}
        add(svc, title, date, time, mins, cal)
    else:
        print(__doc__)

if __name__ == "__main__":
    main()
